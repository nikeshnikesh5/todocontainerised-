# Use Node 20 alpine
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Copy package files first (for caching)
COPY package*.json ./

# Define build argument for React
ARG REACT_APP_BACKEND_URL

# Make it available as an environment variable for npm build
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL

# Install dependencies
RUN npm install

# Copy the rest of the code
COPY . .

# Build the app (React reads REACT_APP_BACKEND_URL here)
RUN npm run build

# Expose port
EXPOSE 3000

# Start the app using serve
CMD ["npx", "serve", "-s", "build", "-l", "3000"]